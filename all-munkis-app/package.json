{
    "name": "all-munkis",
    "version": "1.0.0",
    "description": "All Munkis — a cozy rainbow toy for kids from The Madderverse. Capacitor-wrapped HTML5, shipping to Google Play + the web.",
    "private": true,
    "author": "Onion Madder / Mad Sundar LLC",
    "license": "UNLICENSED",
    "scripts": {
        "serve":             "python3 -m http.server 8000",
        "cap:add:android":   "cap add android",
        "cap:sync":          "cap sync",
        "cap:open:android":  "cap open android",
        "cap:run:android":   "cap run android",
        "assets:generate":   "capacitor-assets generate --android --iconBackgroundColor '#0c0c1a' --iconBackgroundColorDark '#0c0c1a' --splashBackgroundColor '#0c0c1a' --splashBackgroundColorDark '#0c0c1a'",
        "screenshots":       "node scripts/capture-screenshots.js"
    },
    "dependencies": {
        "@capacitor/core":          "^6.1.0",
        "@capacitor/android":       "^6.1.0",
        "@capacitor/preferences":   "^6.0.0",
        "@capacitor/share":         "^6.0.0",
        "@capacitor/status-bar":    "^6.0.0",
        "@capacitor/splash-screen": "^6.0.0"
    },
    "devDependencies": {
        "@capacitor/cli":     "^6.1.0",
        "@capacitor/assets":  "^3.0.5",
        "playwright":         "^1.45.0"
    }
}
