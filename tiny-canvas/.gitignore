# Node / Capacitor
node_modules/
package-lock.json
.DS_Store

# Capacitor-generated native projects.
# These are generated by `npx cap add ios` / `npx cap add android`
# and should be committed once they exist (Capacitor projects need
# the native folders versioned so signing configs + plugin podfiles
# stay reproducible). They are listed here as build artifacts to
# remind that the contents inside are largely tooling-managed —
# uncomment if a future workflow ever wants them ignored.
# ios/
# android/

# Build outputs
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# Generated by capacitor sync
ios/App/public/
android/app/src/main/assets/public/
