# Node / Capacitor
node_modules/
package-lock.json
.DS_Store

# Capacitor-generated native project.
# `android/` is generated by `npx cap add android`. Commit it once it
# exists — Capacitor projects need the native folder versioned so the
# signing config + Gradle setup stay reproducible across machines.
# (Left here as a reminder, NOT ignored.)
# android/

# Build outputs
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/release/
android/app/*.apk
android/app/*.aab

# Capacitor sync target
android/app/src/main/assets/public/

# Release signing — NEVER commit these.
*.jks
*.keystore
keystore.properties

# Screenshot capture output (regenerate via npm run screenshots)
store-assets/screenshots/*/
