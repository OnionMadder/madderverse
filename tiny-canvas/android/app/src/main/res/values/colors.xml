<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Recreated by hand: `npx @capacitor/assets generate` rewrites
        res/values/ and removed the colors.xml the Capacitor template
        ships, while styles.xml still references @color/colorPrimaryDark.
        The build only kept working because stale merged resources in
        android/app/build/ still had it; a clean checkout would fail.

        colorPrimaryDark is the Android status-bar colour below the
        edge-to-edge era (targetSdk is 34). It was defaulting to
        Capacitor's grey-blue, which is why the bar above the app read
        grey instead of the app's own near-black teal.
    -->
    <color name="colorPrimary">#06141a</color>
    <color name="colorPrimaryDark">#06141a</color>
    <color name="colorAccent">#ff2e88</color>
</resources>
