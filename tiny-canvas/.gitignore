# Node / Capacitor
node_modules/
package-lock.json
.DS_Store

# Capacitor-generated native projects — NOT committed.
#
# This matches every other Madderverse app: slip-studio-app/,
# pootery-app/, cookie-cache-app/ and all-munkis-app/ all keep their
# Capacitor wrap outside git. Regenerate with `npx cap add android`.
#
# ⚠ Two things do NOT survive that regeneration and have to be
# reapplied by hand — both are written up under "Android build" in
# CLAUDE.md, because losing them is silent:
#   1. res/values/colors.xml (the status-bar colour; `npx
#      @capacitor/assets generate` deletes it while styles.xml still
#      references @color/colorPrimaryDark, which breaks a clean build)
#   2. any signing config, once a release keystore exists
ios/
android/

# Build outputs
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# Generated by capacitor sync
ios/App/public/
android/app/src/main/assets/public/

# Staged native payload — regenerate with `node scripts/build-www.mjs`.
# Never edit www/ by hand; it is a copy of the web build with the
# web-only chrome stripped.
www/

# Rasterized icon sources for @capacitor/assets, generated from icons/*.svg
.assetsrc/

# Master coloring-page art (2816x1536 originals, ~53MB) — the shipped
# pages in assets/coloring-pages/ are generated from these by
# scripts/process-coloring-pages.py. Untracked like all Madderverse
# working art; keep local copies safe, this is the only source.
art-src/

# Signing material — NEVER commit. Mirrored to ~/Keystore-Backups/tiny-canvas/,
# which is the only durable copy since android/ is untracked.
*.keystore
*.jks
keystore.properties
